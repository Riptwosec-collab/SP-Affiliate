{
  "buildCommand": "npm run build:site",
  "outputDirectory": "dist",
  "framework": null,
  "git": {
    "deploymentEnabled": {
      "*": false,
      "**": false,
      "main": true
    }
  },
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "headers": [{"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"no-referrer"},{"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"}]}]
}
